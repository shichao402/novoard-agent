{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Novoard Agent",
  "version": "0.3.2",
  "identifier": "com.novoard.agent",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Novoard Agent",
        "url": "index.html",
        "width": 1100,
        "height": 760,
        "minWidth": 760,
        "minHeight": 520,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Novoard federated execution agent",
    "longDescription": "Desktop tray host for the Novoard federated execution agent.",
    "externalBin": [
      "binaries/novoard-agent"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-",
      "hardenedRuntime": false
    }
  }
}
