{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Novoard Agent desktop client",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "allow-read-logs",
    "allow-restart-agent",
    "allow-agent-endpoint",
    "allow-autostart-enabled",
    "allow-set-autostart",
    "allow-open-log-dir",
    "dialog:allow-open"
  ]
}
