{
  "name": "novoard-agent",
  "version": "0.3.2",
  "description": "Novoard 联邦执行 agent：Windows/macOS 托盘桌面壳 + Linux 无头服务，接入任意 Novoard hub",
  "type": "module",
  "bin": {
    "novoard-agent": "src/sea-entry.mjs"
  },
  "scripts": {
    "start": "node src/main.mjs",
    "build": "node scripts/build-agent.mjs",
    "smoke:sidecar": "node scripts/smoke-agent-host.mjs",
    "desktop:stage": "node scripts/stage-desktop-sidecar.mjs",
    "desktop:check": "cargo test --manifest-path desktop/src-tauri/Cargo.toml",
    "desktop:dev": "npm run build && npm run desktop:stage && cd desktop && npx tauri dev",
    "desktop:build": "npm run build && node scripts/stage-agent-runtime.mjs && npm run desktop:stage && cd desktop && npx tauri build",
    "desktop:dev-deploy": "node scripts/deploy-windows-dev.mjs",
    "desktop:release-deploy": "node scripts/deploy-windows-release.mjs",
    "release:sync-version": "node scripts/sync-release-version.mjs",
    "contract-gate": "node scripts/check-contract-copy.mjs",
    "test": "npm run contract-gate && node --test \"test/*.mjs\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@tencent-ai/agent-sdk": "^0.3.282",
    "ajv": "^8.17.0",
    "ws": "^8.18.0",
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.3",
    "esbuild": "^0.28.2",
    "postject": "^1.0.0-alpha.6"
  },
  "engines": {
    "node": ">=22"
  }
}
