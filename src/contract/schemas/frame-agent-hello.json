{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "novoard/frame-agent-hello.json",
  "title": "ops 帧 agent.hello（注册 / 重连）",
  "type": "object",
  "required": ["type", "contractVersion", "agentId", "card"],
  "properties": {
    "type": { "const": "agent.hello" },
    "contractVersion": { "type": "string", "pattern": "^\\d+\\.\\d+$" },
    "agentId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "card": { "$ref": "agent-card.json" },
    "bootId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "description": "进程启动时生成，只放内存。同一进程重连不变，进程重启才变（契约 §4.4）"
    },
    "inFlightTaskIds": {
      "type": "array",
      "description": "重连时上报在途任务，供 hub 对账（契约 §4.4）",
      "items": { "type": "string", "pattern": "^task-" }
    },
    "app": {
      "type": "object",
      "description": "agent 程序自身的版本信息（契约 v2.3），hub 只记录和展示，不做准入判断。版本事实源是 relkit 服务器",
      "required": ["version"],
      "properties": {
        "version": { "type": "string", "minLength": 1, "description": "程序版本，如 0.3.4" },
        "channel": { "type": "string", "description": "更新渠道：stable / dev；未接入更新的构建为 local" },
        "platform": { "type": "string", "description": "运行平台，如 win32-x64、darwin-arm64" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
