{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "novoard/agent-card.json",
  "title": "Agent Card（单成员；聚合 card 附 x-novoard-members 扩展字段）",
  "type": "object",
  "required": ["name", "description", "version", "capabilities", "defaultInputModes", "defaultOutputModes", "skills"],
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "capabilities": {
      "type": "object",
      "required": ["streaming", "pushNotifications"],
      "properties": {
        "streaming": { "type": "boolean" },
        "pushNotifications": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "defaultInputModes": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "defaultOutputModes": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "description"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$",
            "description": "skill id = target id（契约 §2 生成规则）"
          },
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "tags": { "type": "array", "items": { "type": "string" } },
          "x-novoard-offline": {
            "type": "object",
            "required": ["policy"],
            "properties": {
              "policy": { "enum": ["reject", "queue"] },
              "ttl": { "type": "string", "pattern": "^\\d+(s|m|h|d)$" }
            },
            "additionalProperties": false,
            "description": "私有扩展（契约 §2，v1.1）：target offline 策略随 card 透传给 hub 路由"
          },
          "x-novoard-notify": {
            "enum": ["always", "on-failure", "never"],
            "description": "私有扩展（契约 §2，M3）：target notify 策略透传，hub 终态通知前查表过滤"
          }
        },
        "additionalProperties": false
      }
    },
    "x-novoard-members": {
      "type": "object",
      "description": "聚合 card 专用：member id → 寻址信息",
      "additionalProperties": { "type": "object" }
    }
  },
  "additionalProperties": false
}
